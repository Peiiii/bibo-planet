# Choose a real provider. No simulated responses or unsupported free-tier fallback.
BIBO_MODEL=deepseek/deepseek-flash
# MINIMAX_API_KEY=...
# Or: BIBO_MODEL=deepseek/deepseek-flash with DEEPSEEK_API_KEY=...
# Or reuse a local NextClaw config without copying its key:
# BIBO_NEXTCLAW_CONFIG=/absolute/path/to/.nextclaw/config.json
PORT=3038
# BIBO_DATA_DIR=/var/lib/bibo-planet
# Public deployment only: exact browser origin and edge-to-origin authentication.
# BIBO_PUBLIC_ORIGIN=https://planet.bibo.bot
# BIBO_EDGE_SECRET=generated-at-deploy-time
