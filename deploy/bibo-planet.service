[Unit]
Description=Bibo Planet shared AI world
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bibo-planet
Group=bibo-planet
WorkingDirectory=/opt/bibo-planet
Environment=NODE_ENV=production
Environment=BIBO_DELETION_LEDGER_DIR=/var/lib/bibo-planet-deletions
Environment=BIBO_OSSUTIL_PATH=/opt/bibo-ossutil-v2/bin/ossutil
Environment=BIBO_DELETION_OSS_PREFIX=oss://bibo-planet-backups-peiiii-2026/deletions
Environment=BIBO_DELETION_OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
Environment=BIBO_DELETION_OSS_REGION=cn-hangzhou
Environment=BIBO_AGENT_RUNTIME_DIR=/run/bibo-planet-agent
EnvironmentFile=/etc/bibo-planet/env
ExecStart=/opt/bibo-node/bin/node --import tsx src/server/main.ts
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RuntimeDirectory=bibo-planet-agent
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/bibo-planet /var/lib/bibo-planet-deletions
CapabilityBoundingSet=
MemoryMax=900M

[Install]
WantedBy=multi-user.target
